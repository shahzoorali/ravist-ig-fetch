# ─────────────────────────────────────────────────────
# Instagram Scraper Service — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────

PORT=3000

# Optional: add a static API key so only your backend can call this service
# Leave blank to disable auth (fine for localhost-only use)
SERVICE_API_KEY=

# ── Instagram session cookies (optional but strongly recommended) ──────────────
# Without these, only Strategy 3 (embed scrape) and Strategy 4 (oEmbed) run.
# With sessionid, all 4 strategies run — much higher success rate on Reels/videos.
#
# How to get these 3 values:
#   1. Log in to instagram.com in Chrome/Edge
#   2. Press F12 → Application tab → Cookies → https://www.instagram.com
#   3. Copy the values of: sessionid, csrftoken, ds_user_id

INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_DS_USER_ID=

# ── Facebook App Token (optional) ─────────────────────────────────────────────
# Only needed for the oEmbed fallback (Strategy 4).
# Without this, oEmbed will return 403.
# Get it from: https://developers.facebook.com → Your App → Settings → Basic
FACEBOOK_APP_TOKEN=
